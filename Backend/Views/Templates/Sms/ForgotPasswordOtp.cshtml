<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SMS Simulation Preview - Campus Services Portal</title>
    <style>
        {{CSS_CONTENT}}
    </style>
</head>
<body>

    <div class="header-title">
        <h1>📱 SMS Simulation Gateway Preview</h1>
        <p>Campus Services Portal — Password Reset Token Dispatch</p>
        <span class="badge">SIMULATION MODE ACTIVE</span>
    </div>

    <div class="phone-frame">
        <div class="phone-top-bar">
            <span>9:41</span>
            <span>📶 5G  🔋 100%</span>
        </div>

        <div class="phone-header">
            <div class="sender-avatar">🎓</div>
            <p class="sender-name">CAMPUS-SECURITY</p>
            <p class="sender-number">Recipient: {{FULL_NAME}} ({{PHONE_NUMBER}})</p>
        </div>

        <div class="chat-body">
            <div class="timestamp-divider">Today • Password Reset Request</div>

            <div class="sms-bubble">
                Hello <strong>{{FULL_NAME}}</strong>,<br>
                A password reset request was initiated for your Campus Portal account.
                
                <div class="otp-container">
                    <div class="otp-label">Single-Use Reset Code</div>
                    <div class="otp-number">{{TOKEN_CODE}}</div>
                </div>

                ⏰ Code expires at: <strong>{{EXPIRES_AT_STR}}</strong>.<br>
                If you did not request this, please contact IT Helpdesk immediately.
            </div>
        </div>

        <div class="phone-footer">
            Text Message • Encrypted Simulation Stream
        </div>
    </div>

</body>
</html>
